<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BKMsystem.Views.DxfViewerWindow"
        Title="Просмотр DXF" Width="600" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid RowDefinitions="Auto,*">
        <!-- Шапка с именем файла -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10">
            <TextBlock x:Name="FileNameText" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>

        <!-- Холст для отрисовки чертежа -->
        <Viewbox Grid.Row="1" Margin="20" Stretch="Uniform">
            <Canvas x:Name="DxfCanvas" Background="#111111" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Viewbox>
    </Grid>
</Window>