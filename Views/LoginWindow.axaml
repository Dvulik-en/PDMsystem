<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BKMsystem.Views.LoginWindow"
        Title="BKMsystem MES — Вход"
        Width="420" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Icon="/Assets/bkm-logo-256.png">

    <Border Margin="30" Background="#1E1E1E" CornerRadius="12" Padding="30">
        <StackPanel Spacing="14" VerticalAlignment="Center">

            <TextBlock Text="BKMsystem MES" FontSize="24" FontWeight="Bold"
                       Foreground="#00E5FF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ModeTitle" Text="Вход в систему" FontSize="14"
                       Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- ФИО — только при регистрации -->
            <StackPanel x:Name="FullNamePanel" Spacing="6" IsVisible="False">
                <TextBlock Text="Фамилия и имя" Foreground="#888888" FontSize="12"/>
                <TextBox x:Name="FullNameBox" Watermark="Иванов Иван" Background="#2A2A2A"
                         Foreground="White" BorderBrush="#3A3A3A" Padding="10,8"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Логин" Foreground="#888888" FontSize="12"/>
                <TextBox x:Name="LoginBox" Watermark="ivanov" Background="#2A2A2A"
                         Foreground="White" BorderBrush="#3A3A3A" Padding="10,8"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Пароль" Foreground="#888888" FontSize="12"/>
                <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="••••"
                         Background="#2A2A2A" Foreground="White" BorderBrush="#3A3A3A" Padding="10,8"/>
            </StackPanel>

            <Button x:Name="ActionButton" Content="Войти" Click="OnActionClick"
                    Background="#2D5A88" Foreground="White" FontWeight="Bold"
                    Padding="10,10" Margin="0,10,0,0" HorizontalContentAlignment="Center"/>

            <Button x:Name="ToggleModeButton" Content="Нет аккаунта? Регистрация" Click="OnToggleModeClick"
                    Background="Transparent" Foreground="#00E5FF" FontSize="12"
                    HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="MessageText" Foreground="#EF9A9A" FontSize="12"
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
