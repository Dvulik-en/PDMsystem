<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BKMsystem.ViewModels"
             xmlns:models="using:BKMsystem.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="BKMsystem.Views.BaseForAjanView"
             x:DataType="vm:BaseForAjanViewModel">

    <Grid Margin="15" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <TextBlock Text="База выполненных карт раскроя (архив)"
                       Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}"
                    Background="#333" Foreground="White" Padding="12,6" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10">
            <TreeView ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}" Background="Transparent">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="models:NestingTreeNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="models:NestingTreeNode" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Icon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#8E8E93"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,15,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                <Button Content="💾 Выгрузить файлы" Command="{Binding ExportCommand}"
                        Background="#2D5A88" Foreground="White" Padding="12,8"/>
                <Button Content="↩ Вернуть в работу" Command="{Binding ReturnToWorkCommand}"
                        Background="#B26A00" Foreground="White" Padding="12,8"/>
                <Button Content="🗑 Удалить"
                    Command="{Binding DeleteSheetCommand}"
                    IsVisible="{Binding CanDelete}"
                    Background="#C62828" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>