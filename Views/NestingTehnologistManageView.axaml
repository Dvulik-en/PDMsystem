<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BKMsystem.ViewModels"
             xmlns:models="using:BKMsystem.Models"
             x:Class="BKMsystem.Views.NestingTehnologistManageView"
             x:Name="RootControl"
             x:DataType="vm:NestingTehnologistManageViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="15">
        <!-- Шапка: одна кнопка загрузки комплекта (несколько УП + один PDF + один Excel) -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                    <Button Content="📥 Загрузить комплект УП (.MPG ×N + .PDF + .XLSX)"
                            Command="{Binding ImportKitCommand}"
                            Background="#2E7D32"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button Content="Сформировать комплект"
                            Command="{Binding CreateDxfPackageCommand}"
                            Background="#00E5FF"
                            Foreground="Black"
                            FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="Учет УП: справа отметьте лист(ы) — они уйдут влево. «Сформировать комплект» и «Загрузить УП» работают по левому дереву (сверка с Excel)."
                           FontSize="13" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Два дерева: слева — листы заданий без УП (привязка), справа — детали ведомости -->
        <Grid Grid.Row="1" ColumnDefinitions="340, *">
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Листы в работе (по ним раскрой). ✕ — отменить. После загрузки УП исчезают"
                               Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TreeView ItemsSource="{Binding PlanTaskTree}"
                              Background="Transparent">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="models:PlanTaskGroupNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="models:PlanTaskGroupNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Content="✕"
                                            Padding="4,0"
                                            FontSize="11"
                                            Background="#442222"
                                            Foreground="#FF8888"
                                            ToolTip.Tip="Снять с работы — вернуть в правое дерево"
                                            Command="{Binding #RootControl.((vm:NestingTehnologistManageViewModel)DataContext).ReleaseTaskReservationCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding ReservationKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="10">
                <TreeView ItemsSource="{Binding PlanTree}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="models:StatementItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="models:StatementItem" ItemsSource="{Binding Children}">
                            <Panel>
                                <!-- 1. УРОВЕНЬ ГРУПП (Планы, Заказы, Материалы) -->
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding IsGroup}"
                                            IsEnabled="{Binding IsEnabled}">

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Command="{Binding #RootControl.((vm:NestingTehnologistManageViewModel)DataContext).ToggleReservationCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding Thickness, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="15"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 2. УРОВЕНЬ ДЕТАЛЕЙ -->
                                <Grid ColumnDefinitions="200, 250, 100"
                                      IsVisible="{Binding !IsGroup}"
                                      IsEnabled="{Binding IsEnabled}"
                                      Margin="24,2,0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding DrawingNumber}" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='{} {0} шт.'}" Foreground="Yellow" VerticalAlignment="Center"/>
                                </Grid>
                            </Panel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>

        <!-- Статус-строка -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#8E8E93"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>