<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BKMsystem.Views.ConfirmDialog"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E1E"
        Title="Подтверждение">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock x:Name="MessageText" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="NoButton" Content="Отмена" Click="OnNoClick"/>
            <Button x:Name="YesButton" Content="Удалить" Background="#C62828" Foreground="White" Click="OnYesClick"/>
        </StackPanel>
    </StackPanel>
</Window>