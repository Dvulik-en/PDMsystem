<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BKMsystem.ViewModels"
        xmlns:views="using:BKMsystem.Views"
        x:Class="BKMsystem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BKMsystem MES"
        Width="1280" Height="800"
        Background="#121212"
        Icon="/Assets/bkm-logo-256.png">

    <Window.DataTemplates>
        <!-- Существующие шаблоны -->
        <DataTemplate DataType="vm:StatementViewModel">
            <views:StatementView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlanViewModel">
            <views:PlanView />
        </DataTemplate>
        <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>

        <!-- Вкладка технолога -->
        <DataTemplate DataType="vm:NestingTehnologistManageViewModel">
            <views:NestingTehnologistManageView />
        </DataTemplate>

        <!-- Вкладка оператора плазмы -->
        <DataTemplate DataType="vm:NestingViewModel">
            <views:NestingView />
        </DataTemplate>

        <!-- Вкладка "База" (архив выполненных карт раскроя) -->
        <DataTemplate DataType="vm:BaseForAjanViewModel">
            <views:BaseForAjanView />
        </DataTemplate>

        <!-- Вкладка "Мастер" (причины недореза) -->
        <DataTemplate DataType="vm:MasterViewModel">
            <views:MasterView />
        </DataTemplate>

        <!-- Вкладка "Метрики" (директор, только чтение) -->
        <DataTemplate DataType="vm:MetricsViewModel">
            <views:MetricsView />
        </DataTemplate>
    </Window.DataTemplates>
    <Window.Styles>
        <!-- Базовый вид кнопки меню -->
        <Style Selector="Button.MenuButton">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Button.MenuButton PathIcon">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>
        <Style Selector="Button.MenuButton TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>

        <!-- Эффект при наведении мыши (:pointerover) -->
        <Style Selector="Button.MenuButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>

        <!-- Меняем цвет текста и иконки при наведении на светлый/белый -->
        <Style Selector="Button.MenuButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.MenuButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <!-- Разделяем окно на 2 колонки: Меню (220px) и Главный контент -->
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="60, *">

        <!-- ЛЕВОЕ БОКОВОЕ МЕНЮ -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#1E1E1E" Padding="{Binding SidebarPadding}" Width="{Binding SidebarWidth}" ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Spacing="10">
                <Button Classes="MenuButton" Command="{Binding ToggleSidebar}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M6,5H18V7H6M7,11H17V13H7M5.5,17H18.5V19H5.5" Width="18" Height="18" Foreground="White"/>
                        <TextBlock Text="BKMsystem" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>

                <!-- Кнопки меню (видимость — по роли вошедшего пользователя) -->
                <Button Classes="MenuButton" Command="{Binding OpenDashboard}" IsVisible="{Binding ShowDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M13,3V9H21V3M13,21H21V11H13M3,21H11V15H3M3,13H11V3H3V13Z" Width="18" Height="18"/>
                        <TextBlock Text="Панель" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>
                <Button Classes="MenuButton" Command="{Binding OpenStatement}" IsVisible="{Binding ShowStatement}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M5 5H7V11H5V5M10 5H8V11H10V5M5 19H7V13H5V19M10 13H8V19H10V17H15V15H10V13M2 21H4V3H2V21M20 3V7H13V5H11V11H13V9H20V15H18V13H16V19H18V17H20V21H22V3H20Z" Width="18" Height="18"/>
                        <TextBlock Text="Ведомость" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>
                <Button Classes="MenuButton" Command="{Binding OpenPlan}" IsVisible="{Binding ShowPlan}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M11 20V22H3C1.9 22 1 21.1 1 20V4C1 2.9 1.9 2 3 2H21C22.1 2 23 2.9 23 4V12.1L22.8 11.9C22.3 11.4 21.7 11.1 21 11.1V6H3V20H11M21.4 13.3L22.7 14.6C22.9 14.8 22.9 15.2 22.7 15.4L21.7 16.4L19.6 14.3L20.6 13.3C20.7 13.2 20.8 13.1 21 13.1C21.2 13.1 21.3 13.2 21.4 13.3M21.1 16.9L15.1 23H13V20.9L19.1 14.8L21.1 16.9Z" Width="18" Height="18"/>
                        <TextBlock Text="План" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>
                <Button Classes="MenuButton" Command="{Binding OpenNestingTehnologistManage}" IsVisible="{Binding ShowNestingManage}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M2 3C2.55 3 3 3.45 3 4V13H5V5C5 4.45 5.45 4 6 4C6.55 4 7 4.45 7 5V13H9V6C9 5.45 9.45 5 10 5C10.55 5 11 5.45 11 6V13H12.5C12.67 13 12.84 13 13 13.05V7C13 6.45 13.45 6 14 6C14.55 6 15 6.45 15 7V15.5C15 16.88 13.88 18 12.5 18H11.5C11.22 18 11 18.22 11 18.5C11 18.78 11.22 19 11.5 19H17V8C17 7.45 17.45 7 18 7C18.55 7 19 7.45 19 8V19H21V9C21 8.45 21.45 8 22 8C22.55 8 23 8.45 23 9V20C23 20.55 22.55 21 22 21H11.5C10.12 21 9 19.88 9 18.5C9 17.12 10.12 16 11.5 16H12.5C12.78 16 13 15.78 13 15.5C13 15.22 12.78 15 12.5 15H2C1.45 15 1 14.55 1 14V4C1 3.45 1.45 3 2 3Z" Width="18" Height="18"/>
                        <TextBlock Text="Учет УП" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>
                <Button Classes="MenuButton" Command="{Binding OpenStock}" IsVisible="{Binding ShowStock}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H11V3M13,3V11H21V5C21,3.89 20.11,3 19,3M13,13V21H19C20.11,21 21,20.11 21,19V13" Width="18" Height="18"/>
                        <TextBlock Text="Склад" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>

                <Button Classes="MenuButton" Command="{Binding OpenNesting}" IsVisible="{Binding ShowNesting}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M18,11H14.82C14.4,9.84 13.3,9 12,9C10.7,9 9.6,9.84 9.18,11H6C5.67,11 4,10.9 4,9V8C4,6.17 5.54,6 6,6H16.18C16.6,7.16 17.7,8 19,8A3,3 0 0,0 22,5A3,3 0 0,0 19,2C17.7,2 16.6,2.84 16.18,4H6C4.39,4 2,5.06 2,8V9C2,11.94 4.39,13 6,13H9.18C9.6,14.16 10.7,15 12,15C13.3,15 14.4,14.16 14.82,13H18C18.33,13 20,13.1 20,15V16C20,17.83 18.46,18 18,18H7.82C7.4,16.84 6.3,16 5,16A3,3 0 0,0 2,19A3,3 0 0,0 5,22C6.3,22 7.4,21.16 7.82,20H18C19.61,20 22,18.93 22,16V15C22,12.07 19.61,11 18,11M19,4A1,1 0 0,1 20,5A1,1 0 0,1 19,6A1,1 0 0,1 18,5A1,1 0 0,1 19,4M5,20A1,1 0 0,1 4,19A1,1 0 0,1 5,18A1,1 0 0,1 6,19A1,1 0 0,1 5,20Z" Width="18" Height="18"/>
                        <TextBlock Text="Раскрои" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>

                <Button Classes="MenuButton" Command="{Binding OpenSettings}" IsVisible="{Binding ShowSettings}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10M11.25,4L10.88,6.61C9.68,6.86 8.62,7.5 7.85,8.39L5.44,7.35L4.69,8.65L6.8,10.2C6.4,11.37 6.4,12.64 6.8,13.8L4.68,15.36L5.43,16.66L7.86,15.62C8.63,16.5 9.68,17.14 10.87,17.38L11.24,20H12.76L13.13,17.39C14.32,17.14 15.37,16.5 16.14,15.62L18.57,16.66L19.32,15.36L17.2,13.81C17.6,12.64 17.6,11.37 17.2,10.2L19.31,8.65L18.56,7.35L16.15,8.39C15.38,7.5 14.32,6.86 13.12,6.62L12.75,4H11.25Z" Width="18" Height="18"/>
                        <TextBlock Text="Настройки" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>
                <Button Classes="MenuButton" Command="{Binding OpenBaseForAjan}" IsVisible="{Binding ShowBaseForAjan}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z" Width="18" Height="18"/>
                        <TextBlock Text="База" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>

                <Button Classes="MenuButton" Command="{Binding OpenMaster}" IsVisible="{Binding ShowMaster}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Width="18" Height="18"/>
                        <TextBlock Text="Мастер" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>

                <Button Classes="MenuButton" Command="{Binding OpenMetrics}" IsVisible="{Binding ShowMetrics}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" Width="18" Height="18"/>
                        <TextBlock Text="Метрики" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- Верхняя панель -->
        <Border Grid.Column="1" Grid.Row="0" Background="#181818" Padding="10">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding CurrentPageTitle}" FontSize="20" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="M12,19.2C9.5,19.2 7.29,17.92 6,16C6.03,14 10,12.9 12,12.9C14,12.9 17.97,14 18,16C16.71,17.92 14.5,19.2 12,19.2M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                              Foreground="#AAAAAA" Width="22" Height="22"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UserRole}" Foreground="White" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ (Здесь отображается текущая страница) -->
        <TransitioningContentControl Grid.Column="1" Grid.Row="1"
                                     Content="{Binding CurrentPage}"
                                     Margin="20"/>
    </Grid>
</Window>
